{
  "name": "nhrms-static",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "python3 -c \"import http.server,socketserver; socketserver.TCPServer.allow_reuse_address=True; httpd=socketserver.TCPServer(('0.0.0.0',8080), http.server.SimpleHTTPRequestHandler); print('serving on 8080'); httpd.serve_forever()\"",
    "build": "node -e \"const fs=require('fs'),path=require('path');fs.rmSync('dist',{recursive:true,force:true});fs.mkdirSync('dist',{recursive:true});const skip=new Set(['dist','node_modules','src','supabase','package.json','package-lock.json','bun.lock','bun.lockb','lovable.toml','tsconfig.json','tsconfig.app.json','tsconfig.node.json','.lovable','.git','.gitignore','.env']);for(const e of fs.readdirSync('.')){if(skip.has(e)||e.startsWith('.'))continue;fs.cpSync(e,path.join('dist',e),{recursive:true});}console.log('dist built');\"",
    "build:dev": "npm run build"
  }
}
